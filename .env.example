# ============================================================================
# VaultStock Environment Configuration
# ============================================================================

# Database file location (SQLite)
VAULTSTOCK_DB_PATH=data/vaultstock.db

# JWT Configuration
# Generate 32+ hex bytes: python -c "import secrets; print(secrets.token_hex(32))"
VAULTSTOCK_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_HEX
VAULTSTOCK_JWT_TTL=3600

# HMAC Audit Chain Key (must be persistent across restarts)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
VAULTSTOCK_AUDIT_KEY=CHANGE_ME_GENERATE_RANDOM_AUDIT_KEY_HEX

# Seed Credentials (if unset, random passwords will be generated and printed to console)
VAULTSTOCK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
VAULTSTOCK_STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD

# Operational Modes
# Set to 1 to enable Swagger /docs, reset-demo, and tamper-demo endpoints
VAULTSTOCK_DEMO_MODE=1
VAULTSTOCK_RELOAD=0

# Allowed CORS Origins (comma-separated)
VAULTSTOCK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
